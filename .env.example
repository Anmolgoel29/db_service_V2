# Copy to .env via ./setup.sh (it fills every CHANGE_ME with a random secret).
# Never commit .env — it is gitignored.

# ─── versions ──────────────────────────────────────────────────────────────
# PG Back Web ships pg_dump for Postgres 13–18 and you pick the dump version
# per database in its UI. Verify your pgbackweb image really carries your
# major before committing to it — see README "Version matching".
PG_VERSION=18
PGBACKWEB_VERSION=0.5.1
PGVIEW_VERSION=latest

# ─── networking ────────────────────────────────────────────────────────────
# Everything binds to loopback. Put a proxy or tunnel in front to expose it.
BIND_ADDR=127.0.0.1

# Host/IP written into the "connect from outside" DSNs in credentials/.
PUBLIC_HOST=127.0.0.1

# Deliberately off the defaults so this can run beside db_service (V1), which
# already holds 5432-5434, 6543-6545 and 8000/8010/8020.
POSTGRES_PORT=5440
PGVIEW_PORT=8040
PGBACKWEB_PORT=8045

# ─── secrets ───────────────────────────────────────────────────────────────
# Superuser for the whole farm. dbctl.sh uses it for every admin action.
POSTGRES_PASSWORD=CHANGE_ME

# Owner of the `pgbackweb` metadata database.
PGBACKWEB_DB_PASSWORD=CHANGE_ME

# PG Back Web encrypts stored destination keys and connection strings with
# this. LOSE IT AND YOUR SAVED DESTINATIONS/CONNECTIONS ARE UNRECOVERABLE.
# Keep a copy somewhere other than this host.
PGBACKWEB_ENCRYPTION_KEY=CHANGE_ME

# pg-view panel login.
PGVIEW_USERNAME=admin
PGVIEW_PASSWORD=CHANGE_ME
PGVIEW_SESSION_SECRET=CHANGE_ME

# Set true to make pg-view refuse every write (browse + SELECT only).
PGVIEW_READ_ONLY=false

# ─── postgres tuning ───────────────────────────────────────────────────────
# Rules of thumb for a dedicated box: shared_buffers ~25% of RAM,
# effective_cache_size ~75%, work_mem small (it is per sort, per connection).
TZ=Asia/Kolkata
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_SHM_SIZE=256mb
# Log statements slower than this many ms (-1 disables).
PG_LOG_MIN_DURATION=1000
